#!/usr/bin/env bash
# catwalk - a cute cat walking across the top of a tmux pane, rendered with
# real images via the Sixel graphics protocol (Konsole + tmux >= 3.2).
#
# Sizing/animation are driven by tmux options (@catwalk-*) or env overrides
# (CATWALK_*). A watchdog is spawned so the terminal's sixel graphics layer
# gets discarded however this cat dies.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=helpers.sh
. "$SCRIPT_DIR/helpers.sh"

GIF="$(catcfg CATWALK_GIF catwalk-gif "$CATWALK_PLUGIN_DIR/cat.gif")"
CACHE="$(catcache)"
HEIGHT_ROWS="$(catcfg CATWALK_HEIGHT catwalk-height 3)" # rows the cat occupies
# Width in columns: an explicit @catwalk-width / CATWALK_WIDTH wins; otherwise
# derive it from @catwalk-height and the GIF's own proportions so the cat stays
# proportionate at any height. RATIO approximates a terminal cell's height/width
# (8x16 fonts ~2.0, this Konsole ~2.4); tune @catwalk-cell-ratio if the cat
# looks squished or skinny.
CATW="$(catcfg CATWALK_WIDTH catwalk-width '')"
if [[ -z "$CATW" ]]; then
    RATIO="$(catcfg CATWALK_CELL_RATIO catwalk-cell-ratio 2.4)"
    IFS=, read -r GW GH < <(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "$GIF" 2>/dev/null || true)
    if [[ "$GW" =~ ^[0-9]+$ && "$GH" =~ ^[0-9]+$ && "$GH" -gt 0 ]]; then
        CATW="$(awk -v h="$HEIGHT_ROWS" -v w="$GW" -v gh="$GH" -v r="$RATIO" 'BEGIN{ x=int(h*w*r/gh+0.5); print (x>0?x:1) }')"
    else
        CATW="28"
    fi
fi
STEP="$(catcfg CATWALK_STEP catwalk-step 1)" # cells to advance per tick
FPS="$(catcfg CATWALK_FPS catwalk-fps 10)"
# Background used for the GIF's transparent pixels (sixel has no alpha).
# Konsole paints unpainted sixel pixels with canvas color #0, so the area
# around the cat shows up as a colored slab unless we paint it ourselves.
# Match the terminal's bg so the slab blends in; empty skips the fill.
BG="$(catbg)"
BGR_BGR=()
if [[ "$BG" =~ ^#([0-9a-fA-F]{2})([0-9a-fA-F]{2})([0-9a-fA-F]{2})$ ]]; then
    BGR_BGR=(
        "$((16#${BASH_REMATCH[1]} * 100 / 255))"
        "$((16#${BASH_REMATCH[2]} * 100 / 255))"
        "$((16#${BASH_REMATCH[3]} * 100 / 255))"
    )
fi
require_cmd python3 || BGR_BGR=()

die() {
    printf 'tmux-catwalk: %s\n' "$*" >&2
    sleep 1
    exit 1
}

require_cmd ffmpeg || die "ffmpeg is required (gif frame extraction)"
require_cmd chafa || die "chafa is required (sixel rendering)"
require_cmd md5sum || die "md5sum is required"
chafa --help 2>&1 | grep -q sixels || die "this chafa build has no sixel support"
[[ -f "$GIF" ]] || die "no cat image at $GIF (set @catwalk-gif)"

# If another catwalk already occupies this window (e.g. spawned during a
# resurrect restore), let it win.
WIN_ID="$(tmux display -p -t "${TMUX_PANE:-}" '#{window_id}' 2>/dev/null || true)"
if [[ -n "$WIN_ID" ]]; then
    COUNT="$(tmux list-panes -t "$WIN_ID" -F '#{pane_start_command}' 2>/dev/null | grep -c catwalk || true)"
    ((COUNT > 1)) && exit 0
fi

FRAME_DELAY="$(awk -v f="$FPS" 'BEGIN{printf "%.3f", 1/f}')"

# Watchdog clears the sixel layer if this cat dies by any means (kill-pane,
# kill-window, kill-session, toggle-off, crash). setsid detaches it from the
# pane's process group so pane teardown signals cannot reach it.
if [[ -z "${CATWALK_NO_WATCHDOG:-}" ]]; then
    setsid nohup "$SCRIPT_DIR/catwatchdog" "$$" \
        </dev/null >/dev/null 2>&1 &
fi

# Cache key includes render size and background color so changing
# @catwalk-width/height or the terminal theme re-renders instead of reusing
# stale frames.
KEY="$(md5sum "$GIF" 2>/dev/null | cut -d' ' -f1)-${CATW}x${HEIGHT_ROWS}"
[[ -n "$BG" ]] && KEY="${KEY}-${BG#\#}"
# bump when the sixel post-processing changes so cached frames re-render
KEY="${KEY}-f1"
SIX_DIR="$CACHE/$KEY"
mkdir -p "$SIX_DIR"

# prune stale cache dirs
for old in "$CACHE"/*; do
    [[ "$old" == "$SIX_DIR" ]] && continue
    [[ -d "$old" ]] && rm -rf "$old"
done

# extract frames once
if ! ls "$SIX_DIR"/f*.png >/dev/null 2>&1; then
    rm -rf "$SIX_DIR"
    mkdir -p "$SIX_DIR"
    ffmpeg -y -loglevel error -i "$GIF" "$SIX_DIR/f%03d.png" 2>/dev/null || true
fi

mapfile -t PNGS < <(ls -1 "$SIX_DIR"/f*.png 2>/dev/null | sort)
N="${#PNGS[@]}"
((N > 0)) || die "could not extract frames from $GIF"

# Pre-render every frame to sixel. Fail loudly instead of silently blanking.
render_sixel() {
    local png="$1" out="$2" bg_opt=() filled
    [[ -n "$BG" ]] && bg_opt=(--bg="$BG")
    if [[ ! -f "$out" ]]; then
        chafa --format=sixel --size="${CATW}x${HEIGHT_ROWS}" "${bg_opt[@]}" "$png" >"$out" 2>/dev/null || {
            rm -f "$out"
            return 1
        }
        # Paint an opaque background under the cat so the terminal's sixel
        # canvas fill (usually a colored slab) never shows through.
        if [[ "${#BGR_BGR[@]}" -eq 3 ]]; then
            filled="${out}.filled"
            if python3 "$SCRIPT_DIR/sixelfill.py" "$out" "$filled" \
                "${BGR_BGR[0]}" "${BGR_BGR[1]}" "${BGR_BGR[2]}" 2>/dev/null; then
                mv -f "$filled" "$out"
            else
                rm -f "$filled"
            fi
        fi
    fi
}

declare -a SIX
for png in "${PNGS[@]}"; do
    out="${png%.png}.six"
    render_sixel "$png" "$out" || die "chafa failed to render $(basename "$png")"
    SIX+=("$out")
done

# walk width in cells
MAXX=1
update_maxx() {
    local PANEW
    PANEW="$(tmux display -p -t "${TMUX_PANE:-}" '#{pane_width}' 2>/dev/null)"
    [[ -z "$PANEW" ]] && PANEW="$(stty size | awk '{print $2}')"
    MAXX=$((PANEW - CATW))
    ((MAXX < 1)) && MAXX=1
}

# paint the whole strip with spaces to overwrite the sixel pixels. On Konsole
# glyph overwrites don't erase sixels (KDE bug 456354), so the watchdog
# discards the graphics layer after this cat dies.
cleanup() {
    printf '\033[1;1H'
    local row
    for ((row = 0; row < HEIGHT_ROWS; row++)); do
        printf '%*s\n' "$((MAXX + CATW))" ""
    done
    printf '\033[?25h'
    exit 0
}
trap cleanup INT TERM HUP EXIT
printf '\033[?25l'
update_maxx
trap 'update_maxx' WINCH

idx=0
x=0
tick=0
while :; do
    # If our tmux server is gone (kill-server) we are orphaned - bow out
    # gracefully so we don't leak. The watchdog clears residue, then exits.
    if ((tick++ % 20 == 0)); then
        tmux has-session >/dev/null 2>&1 || break
    fi
    # full clear + home, so tmux forgets the previous image
    printf '\033[2J\033[1;1H'
    printf '\033[1;%dH' "$((x + 1))"
    if [[ -f "${SIX[$idx]}" ]]; then
        cat "${SIX[$idx]}" 2>/dev/null
    else
        cat "${SIX[0]}" 2>/dev/null
    fi
    x=$((x + STEP))
    ((x > MAXX)) && x=0
    idx=$(((idx + 1) % N))
    sleep "$FRAME_DELAY"
done
