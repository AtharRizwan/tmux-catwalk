#!/usr/bin/env bash
# cattoggle - flip the global @cats-on master switch.
#   ON:  ensure a cat in every window.
#   OFF: kill every catwalk pane.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=helpers.sh
. "$SCRIPT_DIR/helpers.sh"

if [[ "$(catopt cats-on 1)" == "1" ]]; then
    tmux set-option -g @cats-on 0
    "$SCRIPT_DIR/catkill"
else
    tmux set-option -g @cats-on 1
    "$SCRIPT_DIR/catensure-all"
fi
